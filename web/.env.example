# --- Admin login ---------------------------------------------------------
# Without ADMIN_PASSWORD the demo password "jtrf@2026" is used (and shown on
# the login page). Always set both of these before giving the link to anyone.
ADMIN_PASSWORD=
SESSION_SECRET=            # any long random string

# --- Public URL used inside QR codes -------------------------------------
# Optional. Auto-detected from the request if empty.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (leave empty = demo mode, data in ./data/demo-db.json) -----
# Run supabase/schema.sql once in the Supabase SQL editor, then fill these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # server only — never expose to the browser
